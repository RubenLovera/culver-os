[Unit]
Description=Perfil Identidad — User profile update
After=network.target

[Service]
Type=oneshot
User=root
WorkingDirectory={{CULVER_OS_DIR}}
EnvironmentFile={{CULVER_OS_DIR}}/.env.admin
ExecStart={{CULVER_OS_DIR}}/venv/bin/python3 {{CULVER_OS_DIR}}/scripts/perfil-identidad.py
StandardOutput=journal
StandardError=journal
