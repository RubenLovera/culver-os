[Unit]
Description=Obsidian Brain Sync — Re-indexes obsidian vault into ChromaDB
After=network.target chroma-server.service

[Service]
Type=oneshot
User=root
WorkingDirectory={{CULVER_OS_DIR}}
EnvironmentFile={{CULVER_OS_DIR}}/.env.admin
ExecStart={{CULVER_OS_DIR}}/venv/bin/python3 {{CULVER_OS_DIR}}/scripts/obsidian-brain-sync.py
StandardOutput=journal
StandardError=journal
