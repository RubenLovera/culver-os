[Unit]
Description=Status Operativo — Wednesday run
After=network.target

[Service]
Type=oneshot
User=root
WorkingDirectory={{CULVER_OS_DIR}}
EnvironmentFile={{CULVER_OS_DIR}}/.env.admin
ExecStart={{CULVER_OS_DIR}}/venv/bin/python3 {{CULVER_OS_DIR}}/scripts/status-operativo.py
StandardOutput=journal
StandardError=journal
