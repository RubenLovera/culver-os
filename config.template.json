{
  "user": {
    "name": "{{USER_NAME}}",
    "timezone": "{{TIMEZONE}}",
    "email": "{{EMAIL}}"
  },
  "agent": {
    "name": "{{AGENT_NAME}}",
    "brain_name": "{{BRAIN_NAME}}"
  },
  "projects": [
    {
      "name": "{{PROJECT_1_NAME}}",
      "description": "{{PROJECT_1_DESC}}"
    }
  ],
  "daily_note": {
    "habits": ["{{HABIT_1}}", "{{HABIT_2}}"],
    "sections": ["{{SECTION_1}}"]
  },
  "personal_vault": {
    "github_repo": "{{GITHUB_USERNAME}}/personal-vault",
    "local_path": "{{PERSONAL_VAULT_LOCAL_PATH}}",
    "daily_notes_subdir": "Daily Notes",
    "weekly_reviews_subdir": "Weekly Reviews"
  },
  "agent_vault": {
    "github_repo": "{{GITHUB_USERNAME}}/{{AGENT_VAULT_REPO}}",
    "local_path": "{{AGENT_VAULT_LOCAL_PATH}}",
    "topics": ["{{TOPIC_1}}", "{{TOPIC_2}}"],
    "raw_subdirs": ["articles", "transcripts", "notes", "personal_vault_sync"],
    "wiki_subdirs": []
  },
  "llm": {
    "provider": "{{LLM_PROVIDER}}",
    "model": "{{LLM_MODEL}}",
    "key": "{{LLM_API_KEY}}"
  },
  "connectors": {
    "enabled": ["obsidian_sync"],
    "obsidian_sync": {
      "sync_folders": ["Daily Notes", "Weekly Reviews"],
      "max_days": 30
    }
  },
  "vps": {
    "ip": "{{VPS_IP}}",
    "provider": "hostinger",
    "ssh_key": "{{SSH_KEY_PATH}}",
    "ssh_user": "root",
    "culver_os_dir": "/root/culver-os"
  },
  "telegram": {
    "group_id": "{{GROUP_ID}}",
    "bots": {
      "admin": {
        "token": "{{ADMIN_BOT_TOKEN}}",
        "thread_id": "{{ADMIN_THREAD_ID}}"
      }
    }
  },
  "github": {
    "username": "{{GITHUB_USERNAME}}",
    "pat": "{{GITHUB_PAT}}"
  }
}
